.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 200rpx;
  background: linear-gradient(135deg, #e8f4fd 0%, #fff5e6 100%);
  box-sizing: border-box;
}

.header { text-align: center; padding: 24rpx 0; }
.title { display: block; font-size: 36rpx; color: #2c5282; font-weight: bold; }
.sub { display: block; font-size: 24rpx; color: #666; margin-top: 8rpx; }

.tabs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; }
.tab {
  flex: 1;
  min-width: 140rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  background: #fff;
  border: 2rpx solid #bee3f8;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #2b6cb0;
}
.tab.active { background: #4299e1; color: #fff; border-color: #4299e1; }

.tone-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tone-card {
  width: calc(50% - 8rpx);
  padding: 24rpx 16rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(44, 82, 130, 0.08);
  box-sizing: border-box;
}
.tone-name { font-size: 22rpx; color: #718096; margin-bottom: 8rpx; }
.tone-char { font-size: 56rpx; color: #2c5282; font-weight: bold; }
.tone-py { font-size: 28rpx; color: #4299e1; margin: 8rpx 0; }
.speak-hint { font-size: 22rpx; color: #d69e2e; }

.group-title { font-size: 28rpx; color: #2c5282; font-weight: bold; margin: 24rpx 0 12rpx; }

.py-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.py-cell {
  width: calc(25% - 9rpx);
  padding: 16rpx 8rpx;
  background: #fff;
  border-radius: 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(44, 82, 130, 0.06);
  box-sizing: border-box;
}
.py-letter { font-size: 32rpx; font-weight: bold; color: #2c5282; }
.py-char { font-size: 28rpx; color: #4299e1; margin: 4rpx 0; }
.py-sub { font-size: 20rpx; color: #888; }

.detail {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  text-align: center;
}
.detail.empty { padding: 32rpx; }
.detail-placeholder { font-size: 28rpx; color: #a0aec0; }
.detail-letter { font-size: 48rpx; color: #2c5282; font-weight: bold; }
.detail-text { font-size: 26rpx; color: #555; margin: 12rpx 0 20rpx; }
.detail-btns { display: flex; justify-content: center; flex-wrap: wrap; }

.speak-btn {
  display: inline-block;
  background: #fefcbf;
  border: 2rpx solid #f6e05e;
  color: #744210;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 6rpx;
}
.speak-btn.secondary { background: #e6fffa; border-color: #81e6d9; color: #234e52; }
