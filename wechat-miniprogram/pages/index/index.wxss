.wrap { padding: 32rpx; }
.header { text-align: center; padding: 24rpx 0 32rpx; }
.title { display: block; font-size: 44rpx; color: #2c5282; font-weight: 600; margin-bottom: 12rpx; }
.sub { display: block; font-size: 28rpx; color: #4a5568; margin-bottom: 8rpx; }
.tip { display: block; font-size: 24rpx; color: #718096; }
.notice {
  margin-top: 24rpx;
  padding: 24rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #718096;
  line-height: 1.6;
}
