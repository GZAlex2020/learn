<view class="wrap">
  <view class="filters">
    <picker mode="selector" range="{{subjectLabels}}" value="{{subjectIndex}}" bindchange="onSubjectChange">
      <view class="filter-pill">科目：{{subjectLabels[subjectIndex]}}</view>
    </picker>
    <picker mode="selector" range="{{typeLabels}}" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="filter-pill">类型：{{typeLabels[typeIndex]}}</view>
    </picker>
  </view>
  <input class="filter-search" placeholder="搜索关键词…" value="{{keyword}}" bindinput="onKeywordInput" />

  <view class="stats">
    <view class="stat"><text class="num">{{summary.total}}</text><text class="label">记录</text></view>
    <view class="stat"><text class="num">{{durationText}}</text><text class="label">时长</text></view>
    <view class="stat"><text class="num">{{summary.subjects['语文']}}</text><text class="label">语文</text></view>
    <view class="stat"><text class="num">{{summary.subjects['数学']}}</text><text class="label">数学</text></view>
    <view class="stat"><text class="num">{{summary.activityTypes['学习'] || 0}}</text><text class="label">学习</text></view>
    <view class="stat"><text class="num">{{summary.activityTypes['背诵'] || 0}}</text><text class="label">背诵</text></view>
  </view>

  <view class="toolbar">
    <button class="btn" size="mini" bindtap="refresh">查询</button>
    <button class="btn btn-primary" size="mini" bindtap="exportReport">导出报告</button>
    <button class="btn btn-warn" size="mini" bindtap="clearAll">清空</button>
  </view>

  <view wx:if="{{groups.length === 0}}" class="empty">没有符合条件的记录</view>

  <block wx:for="{{groups}}" wx:key="date">
    <view class="date-group">
      <view class="date-head">
        <text class="date-label">{{item.dateLabel}}</text>
        <text class="date-stat">{{item.dateStat}}</text>
      </view>
      <view wx:for="{{item.records}}" wx:for-item="rec" wx:key="id"
        class="record {{rec.subject === '数学' ? 'math' : ''}} {{rec.activityType === '背诵' ? 'recite' : ''}}">
        <view class="record-head">
          <text class="record-title">{{rec.subject}} · {{rec.moduleName}}{{rec.subName ? ' · ' + rec.subName : ''}}</text>
          <view class="record-actions">
            <text class="badge {{rec.activityType === '背诵' ? 'badge-recite' : ''}}">{{rec.activityType === '背诵' ? '背诵' : '完成'}}</text>
            <text class="btn-delete" data-id="{{rec.id}}" bindtap="deleteOne">删除</text>
          </view>
        </view>
        <view class="meta">
          <text>时间：{{rec.timeText}}{{rec.durationText ? '（' + rec.durationText + '）' : ''}}</text>
          <text wx:if="{{rec.activityType !== '背诵'}}">进度：{{rec.progressText}}</text>
          <text>结果：{{rec.result}}{{rec.percentText}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
